# ============================================================
# AutoNote AI - Backend Environment Configuration
# ============================================================

# Groq API key
GROQ_API_KEY=your_groq_api_key_here


# ============================================================
# Speech-to-Text
# ============================================================

GROQ_TRANSCRIBE_MODEL=whisper-large-v3-turbo


# ============================================================
# AI Study Material Generation
# OpenAI GPT-OSS-120B served through GroqCloud
# ============================================================

GROQ_CHAT_MODEL=openai/gpt-oss-120b


# ============================================================
# Database
# ============================================================

# Postgres connection string. Users and lectures are stored here so data
# survives restarts/redeploys. Free options: https://neon.com or
# https://supabase.com — create a project, copy the connection string.
# For local Postgres: postgres://user:password@localhost:5432/autonote
DATABASE_URL=postgres://user:password@host:5432/dbname


# ============================================================
# Authentication
# ============================================================

# Secret used to sign login sessions (JWTs). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_string


# ============================================================
# Server
# ============================================================

PORT=3001

FRONTEND_ORIGIN=http://localhost:5173


# ============================================================
# Optional YouTube Downloader Configuration
# ============================================================

# Set this only if yt-dlp cannot be detected automatically.
#
# Example:
# YT_DLP_PATH=/path/to/yt-dlp

# YT_DLP_PATH=