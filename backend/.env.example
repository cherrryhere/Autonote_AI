# Get a free key from https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Models (defaults work well for free tier)
GROQ_TRANSCRIBE_MODEL=whisper-large-v3-turbo
GROQ_CHAT_MODEL=llama-3.3-70b-versatile

# Server config
PORT=3001
FRONTEND_ORIGIN=http://localhost:5173

# Optional — point at a manually-installed yt-dlp binary if the npm postinstall
# can't auto-download it (GitHub rate-limited, corporate proxy, etc.).
# Get the binary from https://github.com/yt-dlp/yt-dlp/releases/latest
# Example: YT_DLP_PATH=C:\tools\yt-dlp.exe
# YT_DLP_PATH=
